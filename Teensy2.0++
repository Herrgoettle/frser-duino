name: Build Teensy++ 2.0 HEX

on:
  workflow_dispatch:
  push:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Quellcode laden (inkl. Submodule)
        uses: actions/checkout@v4
        with:
          submodules: recursive

      - name: AVR-Compiler installieren
        run: |
          sudo apt-get update
          sudo apt-get install -y gcc-avr avr-libc binutils-avr

      - name: frser-duino.hex für Teensy++ 2.0 bauen
        run: make teensy2pp

      - name: Fertige HEX-Datei bereitstellen
        uses: actions/upload-artifact@v4
        with:
          name: teensy2pp-flashrom-hex
          path: frser-duino.hex
